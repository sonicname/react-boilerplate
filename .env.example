# Copy to `.env` for personal overrides and secrets (git-ignored). Validated at startup by
# app/lib/env.server.ts; committed defaults per environment live in `.env.<APP_ENV>`.

# local | development | staging | production. Picks `.env.<APP_ENV>`.
# Defaults to local in dev, production under `pnpm start` / Docker.
#APP_ENV=local

# Public origin of this deployment (sent to the browser).
#APP_URL=http://localhost:5173

# Postgres connection. Required unless APP_ENV=local, which falls back to the embedded PGlite
# database in .data/pglite.
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/react_boilerplate

# debug | info | warn | error
#LOG_LEVEL=info
